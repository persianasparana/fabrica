# Copie para .env e ajuste antes de `docker compose up`.
# (.env não deve ser versionado.)

# --- Admin inicial do PCP (criado no primeiro start, se o banco estiver vazio) ---
PCP_ADMIN_USER=admin
PCP_ADMIN_PASSWORD=
PCP_ADMIN_NAME=Administrador

# --- Admin inicial do Qualidade ---
QUALIDADE_ADMIN_USER=admin
QUALIDADE_ADMIN_PASSWORD=
QUALIDADE_ADMIN_NAME=Administrador

# Cookies de sessão sem flag Secure (necessário em HTTP/localhost).
# Em produção atrás de HTTPS, defina 0.
PP_INSECURE_COOKIES=1
