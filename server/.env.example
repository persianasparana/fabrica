# Copie para .env e ajuste. (.env não é versionado.)

# --- PostgreSQL (use DATABASE_URL OU as variáveis PG*) ---
# DATABASE_URL=postgres://fabrica_user:SENHA@127.0.0.1:5432/fabrica_db
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=fabrica_user
PGPASSWORD=
PGDATABASE=fabrica_db

# --- Servidor ---
# Porta na faixa de apps novos do servidor compartilhado (>= 3020).
HOST=127.0.0.1
PORT=3020
SESSION_SECRET=troque-por-uma-chave-aleatoria-longa
SESSION_MAX_AGE_MS=28800000      # 8 horas

# Atrás do Nginx com HTTPS, defina ambos:
TRUST_PROXY=1
COOKIE_SECURE=auto               # 'auto' usa X-Forwarded-Proto; '1' força; vazio = inseguro (HTTP local)

# Servir os frontends pelo Node (1) ou deixar o Nginx servir os estáticos (0)
SERVE_STATIC=1
# PCP_DIST=/var/www/fabrica/pcp/frontend/dist
# QUALIDADE_DIR=/var/www/fabrica/qualidade/public

# --- Admin inicial (para `npm run install-app` não interativo) ---
FABRICA_ADMIN_USER=admin
FABRICA_ADMIN_PASSWORD=
FABRICA_ADMIN_NAME=Administrador

# --- Rate limiting de login ---
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_SECONDS=900

# --- Integração com a Logística (persianas-api) ---
# Chave compartilhada para o endpoint /api/integracao/* (header X-API-Key).
# Gere com: openssl rand -hex 32 — e configure a MESMA chave no .env da
# Logística (FABRICA_API_KEY). Vazio = integração desativada (503).
INTEGRACAO_API_KEY=

# ===== Ciclo do pedido — Fase B (avaliação do PCP) =====
# O PCP consome os pedidos do COMERCIAL (Agenda :3010) e devolve/libera via
# PATCH. A chave deve ser IDÊNTICA ao SERVICE_API_KEY do .env do Comercial.
COMERCIAL_API_BASE=http://127.0.0.1:3010
COMERCIAL_SERVICE_KEY=trocar_pela_service_api_key_do_comercial

# ===== F3 — Núcleo de Produtos & Precificação (:3070) =====
# OPCIONAL: enriquece a Saída de Materiais da Ordem de Corte com o BOM+custo
# do Núcleo (por produto_sku da estrutura). Se PRODUTOS_BOM_ENABLED != 1 ou o
# Núcleo estiver fora, a OC sai normal (sem custos). Chave = SERVICE_KEY do Núcleo.
PRODUTOS_API_BASE=http://127.0.0.1:3070/api/v1
PRODUTOS_SERVICE_KEY=trocar_pela_service_key_do_nucleo_produtos
PRODUTOS_BOM_ENABLED=0
