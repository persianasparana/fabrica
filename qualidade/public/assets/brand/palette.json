{
  "$schema": "https://persianasparana.com.br/brand/palette.schema.json",
  "name": "Persianas Paraná — Design Tokens",
  "version": "1.0.0",
  "note": "Fonte ÚNICA da identidade visual. Provisório: baseado no terracota #C0392B já em uso. Substitua os valores por cores oficiais quando disponíveis — todos os apps consomem este arquivo (via tokens.css e tailwind.config.js).",
  "color": {
    "brand": {
      "50":  "#FBEAE8",
      "100": "#F6D0CC",
      "200": "#ECA69D",
      "300": "#E07D70",
      "400": "#D45645",
      "500": "#C0392B",
      "600": "#A83024",
      "700": "#8A271E",
      "800": "#6B1E17",
      "900": "#4D1510"
    },
    "sand": {
      "50":  "#FAF9F6",
      "100": "#F1EFE8",
      "200": "#E5E2D8",
      "300": "#D2CEC1",
      "400": "#B4AF9F",
      "500": "#8C8775",
      "600": "#6B6757",
      "700": "#4E4B3E",
      "800": "#332F26",
      "900": "#1F1C16"
    },
    "night": {
      "50":  "#E9E7E3",
      "100": "#C9C5BD",
      "200": "#9B968B",
      "300": "#6E6A5F",
      "400": "#4A463D",
      "500": "#332F28",
      "600": "#272320",
      "700": "#1D1A17",
      "800": "#15120F",
      "900": "#0E0C0A",
      "950": "#080706"
    },
    "semantic": {
      "success":    "#3B6D11",
      "successBg":  "#EAF3DE",
      "warning":    "#854F0B",
      "warningBg":  "#FAEEDA",
      "danger":     "#922B21",
      "dangerBg":   "#FCEBEB",
      "info":       "#2471A3",
      "infoBg":     "#E6F0F6"
    }
  },
  "font": {
    "sans": "'Bricolage Grotesque', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "body": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "mono": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace"
  },
  "radius": { "sm": "6px", "md": "8px", "lg": "12px", "xl": "16px" },
  "shadow": {
    "sm": "0 1px 2px rgba(31,28,22,0.06)",
    "md": "0 4px 12px rgba(31,28,22,0.08)",
    "lg": "0 10px 30px rgba(31,28,22,0.10)"
  }
}
